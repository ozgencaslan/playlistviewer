<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <AndroidStoreBuild>true</AndroidStoreBuild>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
    <AndroidPackageFormats>aab</AndroidPackageFormats>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(PLAY_STORE_KEYSTORE_PATH)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(PLAY_STORE_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(PLAY_STORE_KEY_PASSWORD)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(PLAY_STORE_STORE_PASSWORD)</AndroidSigningStorePass>
  </PropertyGroup>
</Project>
